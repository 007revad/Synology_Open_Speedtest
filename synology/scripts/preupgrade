#!/bin/sh

PKG_NAME=$(basename "$SYNOPKG_PKGDEST")
DSM=$(get_key_value /etc.defaults/VERSION majorversion)
if [[ "$DSM" -gt "6" ]]; then
    VAR_DIR="/var/packages/$PKG_NAME/var"
else
    VAR_DIR="/var/packages/$PKG_NAME/etc"
fi

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${VAR_DIR}/install.log" 2>/dev/null || echo "$1"
}

mkdir -p "$VAR_DIR" 2>/dev/null || true
echo "" >> "$VAR_DIR/install.log"

# Remove older package version's nginx conf symlink
# It actually caused wildly inaccurate Upload speeds via https
if [[ "$DSM" -le "6" ]]; then
    NGINX_LINK="/usr/syno/share/nginx/conf.d/dsm.$PKG_NAME.conf"
    if [ -L "$NGINX_LINK" ]; then
        rm -f "$NGINX_LINK" && \
            log_message "Removed DSM 6 nginx config symlink" || \
            log_message "Warning: Failed to remove DSM 6 nginx config symlink"
    else
        log_message "No DSM 6 nginx config symlink found"
    fi
fi

exit 0
